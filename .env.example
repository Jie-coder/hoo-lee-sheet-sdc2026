AI_PROVIDER=google            # "google" (default, Gemini) or "runpod" (optional)
AI_MODEL=                     # Gemini: optional override (empty = default). RunPod: required, the deployed model name
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MOCK=false                 # true returns fixtures/sample-response.json instead of calling any AI provider
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=     # same value as SUPABASE_URL; scripts/import-data.ts --apply accepts either
SUPABASE_SERVICE_ROLE_KEY=
# Optional RunPod (only used when AI_PROVIDER=runpod)
RUNPOD_BASE_URL=              # https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=           # only for the official template's runpod/handler.py endpoint (/runsync); the app itself does not read it
# scripts/import-data.ts --apply (reads .env.local directly, not process.env)
GEMINI_API_KEY=               # same key as GOOGLE_GENERATIVE_AI_API_KEY; either name works for --apply
# Replit AI Integrations: when both are set, getModel() uses Claude Haiku instead of Gemini
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Live arXiv trend refresh (POST /api/refresh-signals). Snapshots are stored in
# Supabase table trend_snapshots (migration supabase/migrations/20261029090000_trend_snapshots.sql)
# when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set; otherwise in a local JSON file.
# Optional: time budget per refresh in ms (default 45000; arXiv asks for 3 s between calls).
ARXIV_REFRESH_BUDGET_MS=
# Optional: local snapshot file path (default: <os tmpdir>/laluan-trend-snapshot.json).
TREND_SNAPSHOT_FILE=
